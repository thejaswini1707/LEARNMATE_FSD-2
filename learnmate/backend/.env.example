# PostgreSQL connection string
DATABASE_URL="postgresql://learnmate:learnmate_dev_pw@localhost:5432/learnmate?schema=public"

# Server
PORT=4000
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated emails that receive the Admin role on registration.
ADMIN_EMAILS=admin@learnmate.edu

# Uploads
MAX_UPLOAD_MB=25

# Password reset
# Links are valid this long and work once.
RESET_TOKEN_TTL_MINUTES=30
# Max forgot/reset-password requests per IP per 15 minutes.
RESET_RATE_LIMIT_MAX=10

# Outgoing email (optional). Leave SMTP_HOST empty to run without email:
# reset links are then printed to the backend console (non-production only).
# Put real credentials in your own .env / hosting secrets - never in source control.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LearnMate <no-reply@learnmate.local>"

# DEVELOPMENT ONLY: with no SMTP server, also return the reset link in the API response
# so the flow can be tried from the UI. Ignored when NODE_ENV=production.
DEV_RETURN_RESET_LINK=false
